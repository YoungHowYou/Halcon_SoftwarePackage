<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* =============================================================</c>
<c>* std_sort — 展平排序（C++ std::sort）</c>
<c>*   输入 real 图像展平（行优先）后排序，结果 reshape 回原尺寸</c>
<c>*   Descending: 0 = 升序, 1 = 降序</c>
<c>* =============================================================</c>
<c>* 数据 [5, 3, 9, 1, 7]（5×1）</c>
<l>gen_image_const (Image, 'real', 5, 1)</l>
<l>set_grayval (Image, 0, 0, 5.0)</l>
<l>set_grayval (Image, 1, 0, 3.0)</l>
<l>set_grayval (Image, 2, 0, 9.0)</l>
<l>set_grayval (Image, 3, 0, 1.0)</l>
<l>set_grayval (Image, 4, 0, 7.0)</l>
<c>* 升序排序 → [1, 3, 5, 7, 9]</c>
<l>std_sort (Image, ImageAsc, 0)</l>
<l>get_grayval (ImageAsc, 0, 0, A0)</l>
<l>get_grayval (ImageAsc, 4, 0, A4)</l>
<c>* 期望: A0 = 1.0（最小）, A4 = 9.0（最大）</c>
<c>* 降序排序 → [9, 7, 5, 3, 1]</c>
<l>std_sort (Image, ImageDesc, 1)</l>
<l>get_grayval (ImageDesc, 0, 0, D0)</l>
<l>get_grayval (ImageDesc, 4, 0, D4)</l>
<c>* 期望: D0 = 9.0（最大）, D4 = 1.0（最小）</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
