<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* =============================================================</c>
<c>* std_lower_bound — 二分查找下界（C++ std::lower_bound）</c>
<c>*   要求输入已按升序排序（可先用 std_sort 排序）</c>
<c>*   返回第一个 &gt;= Value 的元素索引（0-based, tuple 输出）</c>
<c>*   若所有元素都 &lt; Value，返回元素个数（即 std 的 end 位置）</c>
<c>* =============================================================</c>
<c>* 有序数据 [1, 3, 5, 7, 9]（5×1）</c>
<l>gen_image_const (Image, 'real', 5, 1)</l>
<l>set_grayval (Image, 0, 0, 1.0)</l>
<l>set_grayval (Image, 1, 0, 3.0)</l>
<l>set_grayval (Image, 2, 0, 5.0)</l>
<l>set_grayval (Image, 3, 0, 7.0)</l>
<l>set_grayval (Image, 4, 0, 9.0)</l>
<c>* 查找已存在的值 5 → 第一个 &gt;= 5 的位置是索引 2</c>
<l>std_lower_bound (Image, 5.0, Index1)</l>
<c>* 期望: Index1 = 2</c>
<c>* 查找不存在的值 6 → 第一个 &gt;= 6 的位置是索引 3（值 7）</c>
<l>std_lower_bound (Image, 6.0, Index2)</l>
<c>* 期望: Index2 = 3</c>
<c>* 查找超出范围的值 100 → 返回元素个数 5</c>
<l>std_lower_bound (Image, 100.0, Index3)</l>
<c>* 期望: Index3 = 5</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
