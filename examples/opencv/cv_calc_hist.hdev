<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* =============================================================</c>
<c>* cv_calc_hist — 灰度直方图（OpenCV calcHist）</c>
<c>*   支持 8 位 / 16 位 / 浮点单通道；输出 1×HistSize 的 real 直方图</c>
<c>* =============================================================</c>
<l>read_image (Image, 'printer_chip/printer_chip_01')</l>
<l>get_image_size (Image, W, H)</l>
<c>* 计算 256 桶直方图，范围为 [0, 256)</c>
<l>cv_calc_hist (Image, Histogram, 256, 0, 256)</l>
<l>get_image_size (Histogram, HistWidth, HistHeight)</l>
<c>* 期望: HistWidth = 256, HistHeight = 1</c>
<l>if (HistWidth != 256 or HistHeight != 1)</l>
<l>  throw ('cv_calc_hist: histogram size wrong')</l>
<l>endif</l>
<c>* 所有桶计数之和应等于像素总数</c>
<l>Total := 0</l>
<l>for i := 0 to 255 by 1</l>
<l>  get_grayval (Histogram, 0, i, BinValue)</l>
<l>  Total := Total + BinValue</l>
<l>endfor</l>
<l>if (Total != W * H)</l>
<l>  throw ('cv_calc_hist: bin sum != pixel count: ' + Total)</l>
<l>endif</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
