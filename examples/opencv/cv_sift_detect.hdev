<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>* SIFT 特征检测示例</l>
<l>read_image (Image, 'printer_chip/printer_chip_01')</l>
<l>hdict_create (DictHandle)</l>
<l>hdict_set_object (Image, DictHandle, 'InputImage')</l>
<l>hdict_set_tuple (DictHandle, 'NFeatures', 0)</l>
<l>cv_sift_detect (DictHandle)</l>
<l>hdict_get_tuple (DictHandle, 'NumKeypoints', NumKP)</l>
<l>hdict_get_tuple (DictHandle, 'KeypointsRow', Rows)</l>
<l>hdict_get_tuple (DictHandle, 'KeypointsCol', Cols)</l>
<l>hdict_get_tuple (DictHandle, 'DescWidth', DescWidth)</l>
<l>hdict_get_object (Descriptors, DictHandle, 'Descriptors')</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
