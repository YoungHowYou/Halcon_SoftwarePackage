<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* =============================================================</c>
<c>* cv_threshold_triangle — 三角法自动阈值（OpenCV）</c>
<c>*   仅支持 8 位单通道（OpenCV 的 THRESH_TRIANGLE 限制）</c>
<c>*   输出二值图 + 自动计算出的阈值</c>
<c>* =============================================================</c>
<l>read_image (Image, 'printer_chip/printer_chip_01')</l>
<c>* 三角法自动阈值</c>
<l>cv_threshold_triangle (Image, ImageOut, ThreshValue)</l>
<c>* 期望: ThreshValue 落在 (0, 255) 区间内</c>
<l>if (ThreshValue &lt;= 0 or ThreshValue &gt;= 255)</l>
<l>  throw ('cv_threshold_triangle: ThreshValue out of range: ' + ThreshValue)</l>
<l>endif</l>
<l>get_image_size (ImageOut, Width, Height)</l>
<c>* 期望: 输出尺寸 == 输入尺寸</c>
<l>get_image_size (Image, IW, IH)</l>
<l>if (Width != IW or Height != IH)</l>
<l>  throw ('cv_threshold_triangle: output size mismatch')</l>
<l>endif</l>
<c>* 输出必须严格二值（只有 0 和 255）</c>
<c>* 统计前景像素数：阈值 1..255 的像素个数应 &gt; 0</c>
<l>threshold (ImageOut, Foreground, 1, 255)</l>
<l>area_center (Foreground, FgArea, _, _)</l>
<l>if (FgArea &lt;= 0)</l>
<l>  throw ('cv_threshold_triangle: no foreground pixels')</l>
<l>endif</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
