<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* 特征匹配 + 变换对齐：三种方式（ORB / AKAZE / SIFT），各一条流程</c>
<c>*   每条流程三步：① 制作模板  ② 匹配  ③ 变换对齐</c>
<c>*   模板：examples/69.tif      目标：examples/95.tif</c>
<c>* ============================================================</c>
<c>* 例程图像目录（read_image 不搜索"当前目录"，这里显式给路径；换机器请改这一行）</c>
<l>ImageDir := 'D:/desk/source/Halcon_Extension/Halcon_SoftwarePackage/examples/'</l>
<l>read_image (ImageTemplate, ImageDir + '69.tif')</l>
<l>read_image (Image, 'D:/desk/data/huan/huan/下相机 上光/191.tif')</l>
<c>* 三个检测器都要求 8 位单通道输入</c>
<l>convert_image_type (ImageTemplate, ImageTemplate8, 'byte')</l>
<l>convert_image_type (Image, Image8, 'byte')</l>
<c></c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>get_image_size (Image8, Width, Height)</l>
<l>dev_open_window (0, 0, 800, int(800.0 * Height / Width), 'black', WindowHandle)</l>
<c>* 整图缩放到窗口（图像比窗口大很多）</c>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (2)</l>
<c></c>
<c>* ===================== 流程 1 / 3：ORB =====================</c>
<c>* ① 制作模板：模板图特征检测（5000 个特征），结果存进 DictRef1</c>
<l>feature_create (ImageTemplate8, 'orb', 5000, DictRef1)</l>
<c>* ② 匹配：目标图检测 + BF 匹配 + RANSAC 部分仿射估计</c>
<l>feature_find (Image8, DictRef1, 'orb', 0.75, 3.0, HomMat2D1, Matches1, Inliers1)</l>
<c>* ③ 变换对齐：用 HomMat2D1 把目标图变换到模板图坐标系（cv_affine_trans_image）</c>
<l>cv_affine_trans_image (Image8, ImageAligned1, HomMat2D1, 'bilinear', 'false')</l>
<l>dev_display (ImageAligned1)</l>
<l>disp_message (WindowHandle, '1/3 ORB    matches=' + Matches1 + '  inliers=' + Inliers1, 'window', 10, 10, 'green', 'false')</l>
<c></c>
<c>* ===================== 流程 2 / 3：AKAZE =====================</c>
<c>* ① 制作模板（AKAZE 用 Threshold 控制特征数量，不用 NFeatures）</c>
<l>feature_create (ImageTemplate8, 'akaze', 0, DictRef2)</l>
<c>* ② 匹配</c>
<l>feature_find (Image8, DictRef2, 'akaze', 0.75, 3.0, HomMat2D2, Matches2, Inliers2)</l>
<c>* ③ 变换对齐</c>
<l>cv_affine_trans_image (Image8, ImageAligned2, HomMat2D2, 'bilinear', 'false')</l>
<l>dev_display (ImageAligned2)</l>
<l>disp_message (WindowHandle, '2/3 AKAZE  matches=' + Matches2 + '  inliers=' + Inliers2, 'window', 10, 10, 'green', 'false')</l>
<c></c>
<c>* ===================== 流程 3 / 3：SIFT =====================</c>
<c>* ① 制作模板：模板图特征检测（2000 个特征）</c>
<l>feature_create (ImageTemplate8, 'sift', 2000, DictRef3)</l>
<c>* ② 匹配</c>
<l>feature_find (Image8, DictRef3, 'sift', 0.75, 3.0, HomMat2D3, Matches3, Inliers3)</l>
<c>* ③ 变换对齐</c>
<l>cv_affine_trans_image (Image8, ImageAligned3, HomMat2D3, 'bilinear', 'false')</l>
<l>dev_display (ImageAligned3)</l>
<l>disp_message (WindowHandle, '3/3 SIFT   matches=' + Matches3 + '  inliers=' + Inliers3, 'window', 10, 10, 'green', 'false')</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="feature_create">
<interface>
<io>
<par name="ImageRef" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="Detector" base_type="ctrl" dimension="0"/>
<par name="NFeatures" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="DictRef" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* 制作模板：模板图做特征检测，关键点与描述子写进字典 DictRef</c>
<c>*   Detector = 'orb' / 'akaze' / 'sift'</c>
<c>*   NFeatures 只对 orb / sift 有效；Threshold 只对 akaze 有效</c>
<l>create_dict (DictRef)</l>
<l>set_dict_object (ImageRef, DictRef, 'InputImage')</l>
<l>set_dict_tuple (DictRef, 'NFeatures', NFeatures)</l>
<l>set_dict_tuple (DictRef, 'Threshold', 0.003)</l>
<l>if (Detector == 'orb')</l>
<l>  cv_orb_detect (DictRef)</l>
<l>elseif (Detector == 'akaze')</l>
<l>  cv_akaze_detect (DictRef)</l>
<l>else</l>
<l>  cv_sift_detect (DictRef)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="feature_create">
<parameters>
<parameter id="Detector"/>
<parameter id="DictRef"/>
<parameter id="ImageRef"/>
<parameter id="NFeatures"/>
</parameters>
</docu>
</procedure>
<procedure name="feature_find">
<interface>
<io>
<par name="ImageTarget" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="DictRef" base_type="ctrl" dimension="0"/>
<par name="Detector" base_type="ctrl" dimension="0"/>
<par name="RatioThresh" base_type="ctrl" dimension="0"/>
<par name="RansacThreshold" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="HomMat2D" base_type="ctrl" dimension="0"/>
<par name="NumGoodMatches" base_type="ctrl" dimension="0"/>
<par name="InlierCount" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* 匹配：目标图特征检测 -&gt; BF 匹配（Lowe 比值测试）-&gt; RANSAC 部分仿射估计</c>
<c>*   返回 HomMat2D（目标图 -&gt; 模板图），可直接喂 cv_affine_trans_image / affine_trans_image</c>
<c>* 模板字典里的关键点与描述子</c>
<l>get_dict_tuple (DictRef, 'KeypointsRow', RefRow)</l>
<l>get_dict_tuple (DictRef, 'KeypointsCol', RefCol)</l>
<l>get_dict_object (DescRef, DictRef, 'Descriptors')</l>
<c>* 目标图检测（检测参数与模板保持一致）</c>
<l>get_dict_tuple (DictRef, 'NFeatures', NFeatures)</l>
<l>get_dict_tuple (DictRef, 'Threshold', Threshold)</l>
<l>create_dict (DictTarget)</l>
<l>set_dict_object (ImageTarget, DictTarget, 'InputImage')</l>
<l>set_dict_tuple (DictTarget, 'NFeatures', NFeatures)</l>
<l>set_dict_tuple (DictTarget, 'Threshold', Threshold)</l>
<l>if (Detector == 'orb')</l>
<l>  cv_orb_detect (DictTarget)</l>
<l>elseif (Detector == 'akaze')</l>
<l>  cv_akaze_detect (DictTarget)</l>
<l>else</l>
<l>  cv_sift_detect (DictTarget)</l>
<l>endif</l>
<l>get_dict_tuple (DictTarget, 'KeypointsRow', TargetRow)</l>
<l>get_dict_tuple (DictTarget, 'KeypointsCol', TargetCol)</l>
<l>get_dict_object (DescTarget, DictTarget, 'Descriptors')</l>
<c>* 描述子宽度：ORB 固定 32；AKAZE / SIFT 由算子写回 DescWidth</c>
<l>if (Detector == 'orb')</l>
<l>  DescWidth := 32</l>
<l>else</l>
<l>  get_dict_tuple (DictRef, 'DescWidth', DescWidth)</l>
<l>endif</l>
<c></c>
<c>* BF 暴力匹配 + Lowe 比值测试</c>
<l>create_dict (DictMatch)</l>
<l>set_dict_object (DescRef, DictMatch, 'DescriptorsRef')</l>
<l>set_dict_object (DescTarget, DictMatch, 'DescriptorsTarget')</l>
<l>set_dict_tuple (DictMatch, 'DescWidth', DescWidth)</l>
<l>set_dict_tuple (DictMatch, 'RatioThresh', RatioThresh)</l>
<l>cv_bf_knn_match (DictMatch)</l>
<l>get_dict_tuple (DictMatch, 'NumGoodMatches', NumGoodMatches)</l>
<l>if (NumGoodMatches &lt; 4)</l>
<l>  throw ('匹配点不足 4 个，无法估计仿射变换')</l>
<l>endif</l>
<l>get_dict_tuple (DictMatch, 'MatchIdxRef', MatchIdxRef)</l>
<l>get_dict_tuple (DictMatch, 'MatchIdxTarget', MatchIdxTarget)</l>
<c>* 按匹配索引取出点对</c>
<l>tuple_select (RefRow, MatchIdxRef, MatchedRefRow)</l>
<l>tuple_select (RefCol, MatchIdxRef, MatchedRefCol)</l>
<l>tuple_select (TargetRow, MatchIdxTarget, MatchedTargetRow)</l>
<l>tuple_select (TargetCol, MatchIdxTarget, MatchedTargetCol)</l>
<c></c>
<c>* 部分仿射估计（RANSAC）：目标图 -&gt; 模板图</c>
<l>create_dict (DictAffine)</l>
<l>set_dict_tuple (DictAffine, 'SrcRow', MatchedTargetRow)</l>
<l>set_dict_tuple (DictAffine, 'SrcCol', MatchedTargetCol)</l>
<l>set_dict_tuple (DictAffine, 'DstRow', MatchedRefRow)</l>
<l>set_dict_tuple (DictAffine, 'DstCol', MatchedRefCol)</l>
<l>set_dict_tuple (DictAffine, 'RansacThreshold', RansacThreshold)</l>
<l>cv_estimate_affine_partial2d (DictAffine)</l>
<l>get_dict_tuple (DictAffine, 'Success', Success)</l>
<l>if (Success == 0)</l>
<l>  throw ('部分仿射估计失败')</l>
<l>endif</l>
<l>get_dict_tuple (DictAffine, 'HomMat2D', HomMat2D)</l>
<l>get_dict_tuple (DictAffine, 'InlierCount', InlierCount)</l>
<l>return ()</l>
</body>
<docu id="feature_find">
<parameters>
<parameter id="Detector"/>
<parameter id="DictRef"/>
<parameter id="HomMat2D"/>
<parameter id="ImageTarget"/>
<parameter id="InlierCount"/>
<parameter id="NumGoodMatches"/>
<parameter id="RansacThreshold"/>
<parameter id="RatioThresh"/>
</parameters>
</docu>
</procedure>
</hdevelop>
