# ---- 构建产物 ----
build/
vcpkg_installed/
lib/
bin/
*.so
*.so.*
*.a
*.o

# ---- CMake 生成文件 ----
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
_deps/
Testing/
Makefile

# ---- 编译中间文件 ----
*.dll
*.lib
*.exp
*.log
*.pdb
*.ilk
*.obj
*.tlog
*.lastbuildstate
*.idb
*.ipdb
*.iobj
*.ipch
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- IDE / 编辑器 ----
*.swp
*.swo
*~
.vs/
.idea/
# 调试/语法检查残留（hcomp -u 检查、hrun 输出、obj）
/Hcvcheck.c
/_hrun_err.txt
/_hrun_out.txt
/*.obj
# 示例运行生成物
/examples/**/*.db
# YOLO 模型权重（111 MB，超过 GitHub 单文件限制，按 examples/yolo/README.md 自行放入）
/examples/yolo/*.bin
# Python 包构建产物（wheel / 构建树 / 元数据）
yolo_core/python/dist/
yolo_core/python/*.egg-info/
yolo_core/python/build/
yolo_core/python/.pytest_cache/
*.whl
# Python 缓存
__pycache__/
*.pyc
# MVTec 官方手册 PDF（仅本地查阅，不入库）
/extension_package_programmers_manual.pdf
