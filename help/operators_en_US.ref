linear_fit_2d(modelExpression,paramNames,xData,yData,zData,linearTolerance,paramValues,rss,rank,success,statusMessage)
short.ascii=Fit a linear-in-parameters model with two independent variables using Eigen ColPivHouseholderQR.
keywords=UserExtensionsFittingLinearLeastSquaresQREigen
module=0 Foundation
parameter=modelExpression
description.ascii=Model expression, linear in parameters, e.g. a+b*x+c*y+d*x*y. Independent variables are named x and y.
parameter_class=input_control
type_list=string
default_value="a+b*x+c*y"
default_type=string
sem_type=string
multivalue=false
parameter=paramNames
description.ascii=Names of the parameters to fit, e.g. a,b,c,d. Must be unique and differ from x,y.
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=xData
description.ascii=Samples of the independent variable x.
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=yData
description.ascii=Samples of the independent variable y.
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=zData
description.ascii=Observed values of the dependent variable z. Length must equal the number of XData/YData.
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=linearTolerance
description.ascii=Tolerance for the parameter-linearity verification (default: 1e-10).
parameter_class=input_control
type_list=real
default_value=1.0e-10
default_type=real
sem_type=number
multivalue=false
parameter=paramValues
description.ascii=Fitted parameter values, ordered like ParamNames.
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=rss
description.ascii=Residual sum of squares (-1 on failure).
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=false
parameter=rank
description.ascii=Rank of the design matrix.
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=success
description.ascii=1 if the fit succeeded, 0 otherwise.
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=statusMessage
description.ascii=Status text of the result.
parameter_class=output_control
type_list=string
default_type=string
sem_type=string
multivalue=false
