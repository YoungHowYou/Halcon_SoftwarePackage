cv_region_features(Regions,Features,Values)
short.ascii=按名称计算 region 的形状特征，对应 HALCON region_features。Features 为特征名元组，口径与 cv_select_shape 完全一致；支持 54 个名称：area/row/column/width/height/ratio/row1/column1/row2/column2/circularity/compactness/convexity/rectangularity/contlength/phi/ra/rb/anisometry/bulkiness/struct_factor（别名 structure_factor）/outer_radius/max_diameter/dist_mean/dist_deviation/roundness/num_sides/orientation/connect_num/holes_num/area_holes/euler_number/rect2_phi/rect2_len1/rect2_len2/moments_m11/moments_m20/moments_m02/moments_ia/moments_ib/moments_m11_invar/moments_m20_invar/moments_m02_invar/moments_phi1/moments_phi2/moments_m21/moments_m12/moments_m03/moments_m30/moments_m21_invar/moments_m12_invar/moments_m03_invar/moments_m30_invar。与 HALCON region_features 实测：27 个特征（ratio、outer_radius、rect2_len1/2、max_diameter、connect_num、holes_num、area_holes、euler_number 与 18 个 moments_*）数值一致（≤1e-13）；其余为已知偏差（phi 系符号相反、roundness 系轮廓口径不同，见 README）。Regions 可为元组，输出 Values 平铺为「区域数 × 特征数」，区域优先，同一区域的各特征值相邻。
keywords=UserExtensionsCVRegionFeaturesRegion
module=0 Foundation
parameter=Regions
description.ascii=输入 region 元组，逐元素计算特征。
parameter_class=input_object
sem_type=region
multivalue=optional
parameter=Features
description.ascii=特征名元组，名称与 cv_select_shape 同名同义。
parameter_class=input_control
value_list=arearowcolumnwidthheightratiorow1column1row2column2circularitycompactnessconvexityrectangularitycontlengthphirarbanisometrybulkinessstruct_factorstructure_factorouter_radiusmax_diameterdist_meandist_deviationroundnessnum_sidesorientationconnect_numholes_numarea_holeseuler_numberrect2_phirect2_len1rect2_len2moments_m11moments_m20moments_m02moments_iamoments_ibmoments_m11_invarmoments_m20_invarmoments_m02_invarmoments_phi1moments_phi2moments_m21moments_m12moments_m03moments_m30moments_m21_invarmoments_m12_invarmoments_m03_invarmoments_m30_invar
type_list=string
default_value="area"
default_type=string
sem_type=string
multivalue=true
parameter=Values
description.ascii=特征值元组，平铺为「区域数 × 特征数」，区域优先。
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=true
cv_gen_rectangle2(Rectangle2,Row,Column,Phi,Length1,Length2)
short.ascii=生成旋转矩形 region，对应 HALCON gen_rectangle2。Row/Column 为中心坐标，Phi 为主轴与列轴夹角（弧度，cv/OpenCV 口径；与 HALCON gen_rectangle2 的 phi 反号，同参数为镜像矩形，phi=0 与 +-pi/2 不受影响），Length1/Length2 为两个方向的半边长（Length1 沿主轴，均 ≥0）。栅格化口径为「像素方格与矩形相交即取」（像素 (r,c) 覆盖 [r-0.5,r+0.5]×[c-0.5,c+0.5]）：实测轴对齐、Phi=π/2、负中心裁剪三档与 HALCON gen_rectangle2 逐像素一致，倾斜档面积差约 2%。注意 Phi 与 cv_smallest_rectangle2 / cv_elliptic_axis 返回的 phi 反号（既有约定偏差）；口径也与 shape_trans 'rectangle2' 不同（后者面积可差约 5%）。参数为标量，不支持原生那样的元组批量。
keywords=UserExtensionsCVRegionGenRectangle2Region
module=0 Foundation
parameter=Rectangle2
description.ascii=输出的旋转矩形 region。
parameter_class=output_object
sem_type=region
multivalue=optional
