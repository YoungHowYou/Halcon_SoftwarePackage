cv_geom_fit(ModelHandle,XData,YData,InitialValues,Threshold,MaxIter,OutlierRatio,Confidence,Seed,ParamValues,InlierMask,ResidualSum,Iterations,Status,StatusMessage,InlierRatio)
short.ascii=用 cv_geom_create 构建的模型句柄做 RANSAC 几何拟合（动态迭代 + LM 精化，零表达式解析开销）。
keywords=UserExtensionsRansacFittingGeometryModel
module=0 Foundation
parameter=ModelHandle
description.ascii=cv_geom_create 生成的模型句柄
parameter_class=input_control
type_list=handle
default_type=handle
sem_type=handle
multivalue=false
parameter=XData
description.ascii=自变量观测数据元组
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=real
multivalue=true
parameter=YData
description.ascii=纵坐标观测数据元组（长度须与 XData 一致）
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=real
multivalue=true
parameter=InitialValues
description.ascii=参数初值元组（长度=参数数，可为空取默认 0）
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=real
multivalue=true
parameter=Threshold
description.ascii=内点几何距离阈值（>0）
parameter_class=input_control
type_list=real
default_type=real
sem_type=real
multivalue=false
parameter=MaxIter
description.ascii=最大迭代次数（>0）
parameter_class=input_control
type_list=integer
default_type=integer
sem_type=integer
multivalue=false
parameter=OutlierRatio
description.ascii=外点比例估计 [0,1)
parameter_class=input_control
type_list=real
default_type=real
sem_type=real
multivalue=false
parameter=Confidence
description.ascii=置信度 (0,1)，<=0 取 0.99
parameter_class=input_control
type_list=real
default_type=real
sem_type=real
multivalue=false
parameter=Seed
description.ascii=随机种子（0=非确定性）
parameter_class=input_control
type_list=integer
default_type=integer
sem_type=integer
multivalue=false
parameter=ParamValues
description.ascii=拟合参数值元组
parameter_class=output_control
type_list=real
default_type=real
sem_type=real
multivalue=true
parameter=InlierMask
description.ascii=内点掩码（1=内点，逐点输出）
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=integer
multivalue=true
parameter=ResidualSum
description.ascii=内点（加权）残差平方和
parameter_class=output_control
type_list=real
default_type=real
sem_type=real
multivalue=false
parameter=Iterations
description.ascii=实际迭代次数
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=integer
multivalue=false
parameter=Status
description.ascii=状态码（0=成功，负值见算子文档）
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=integer
multivalue=false
parameter=StatusMessage
description.ascii=状态描述文本
parameter_class=output_control
type_list=string
default_type=string
sem_type=string
multivalue=false
parameter=InlierRatio
description.ascii=内点比例
parameter_class=output_control
type_list=real
default_type=real
sem_type=real
multivalue=false
cv_geom_create(ModelExpression,XName,YName,ParamNames,ModelType,ResidualType,ModelHandle)
short.ascii=构建 RANSAC 几何拟合模型：表达式白名单校验 + 预编译 + 最小采样数自动推导（只解析一次），返回可复用句柄。配合 cv_geom_fit 反复拟合、cv_fit_clear 释放。
keywords=UserExtensionsRansacFittingGeometryModel
module=0 Foundation
parameter=ModelExpression
description.ascii=模型表达式：显式 y=f(x) 或隐式 F(x,y)=0（圆/椭圆/圆锥曲线）
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=false
parameter=XName
description.ascii=自变量名（如 x）
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=false
parameter=YName
description.ascii=纵坐标名（如 y，隐式模型必填）
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=false
parameter=ParamNames
description.ascii=参数名元组
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=ModelType
description.ascii=模型类型：explicit（y=f(x)）/ implicit（F(x,y)=0），大小写不敏感，也接受 0/1
parameter_class=input_control
type_list=stringinteger
default_type=string
sem_type=string
multivalue=false
parameter=ResidualType
description.ascii=残差类型：vertical（|y-f(x)|，仅显式）/ geometric（几何距离，推荐），大小写不敏感，也接受 0/1
parameter_class=input_control
type_list=stringinteger
default_type=string
sem_type=string
multivalue=false
parameter=ModelHandle
description.ascii=几何拟合模型句柄（cv_geom_fit 输入，cv_fit_clear 释放）
parameter_class=output_control
type_list=handle
default_type=handle
sem_type=handle
multivalue=false
