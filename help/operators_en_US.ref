eigen_lm_fit_2d(expressions,paramNames,initialValues,xNames,xData,yData,maxIter,eps,paramValues,rss,iterations,status,statusMessage)
short.ascii=Multi-variable multi-output nonlinear least-squares fit with shared parameters using Eigen LevenbergMarquardt.
keywords=UserExtensionsFittingLevenbergMarquardtOptimizationEigenDistortion
module=0 Foundation
parameter=expressions
description.ascii=One or more model expressions, e.g. one for dx and one for dy. All of them share ParamNames.
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=paramNames
description.ascii=Names of the shared parameters, e.g. k1,k2,k3,p1,p2. Must be unique and differ from XNames.
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=initialValues
description.ascii=Initial parameter values. Length must equal the number of ParamNames.
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=xNames
description.ascii=One or more independent variable names, e.g. u,v. Precomputed terms such as r2=u^2+v^2 may be passed as extra variables.
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=xData
description.ascii=Independent variable samples, length = numPoints * numXNames (M values per point, row major).
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=yData
description.ascii=Observed values, length = numPoints * numExpressions (K values per point, row major).
parameter_class=input_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=maxIter
description.ascii=Maximum number of function evaluations (0 selects 400*(numParams+1)).
parameter_class=input_control
type_list=integer
default_value=0
default_type=integer
sem_type=number
multivalue=false
parameter=eps
description.ascii=Step size for numerical differentiation (0 selects it automatically).
parameter_class=input_control
type_list=real
default_value=0.0
default_type=real
sem_type=number
multivalue=false
parameter=paramValues
description.ascii=Fitted parameter values, ordered like ParamNames.
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=rss
description.ascii=Residual sum of squares over all outputs (-1 if the expression could not be evaluated).
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=false
parameter=iterations
description.ascii=Number of iterations performed.
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=status
description.ascii=LevenbergMarquardt status code (1-4 converged, 5-8 finished without confirmation, 0 failed).
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=statusMessage
description.ascii=Status text of the result (contains expression error: ... on failure).
parameter_class=output_control
type_list=string
default_type=string
sem_type=string
multivalue=false
