default_type=handle
sem_type=handle
multivalue=false
cv_akaze_detect(DictHandle)
short.ascii=AKAZE 特征检测与描述子计算，对应 cv::AKAZE。输入 8 位单通道图像，输出关键点与描述子写回 dict。参数经 dict 键全开放（DescriptorType/Threshold/NOctaves/NOctaveLayers/Diffusivity 等），未设取默认。
keywords=UserExtensionsAKAZEFeatureDetectionOpenCV
module=0 Foundation
parameter=DictHandle
