cv_ransac_fit(ModelExpression,ParamNames,InitialValues,XData,YData,XName,Threshold,MaxIter,OutlierRatio,ModelType,YName,MinSampleSize,Confidence,Seed,ParamValues,InlierMask,ResidualSum,Iterations,Status,StatusMessage,InlierRatio)
short.ascii=RANSAC generic geometric fitting (cv_region).
keywords=UserExtensionsRANSACFittingMuparser
module=0 Foundation
parameter=ModelExpression
description.ascii=模型表达式（muparser 语法）：显式 y=f(x) 或隐式 F(x,y)=0。
parameter_class=input_control
type_list=string
default_value="a*x+b"
default_type=string
sem_type=string
multivalue=false
parameter=ParamNames
description.ascii=参数名元组（与 InitialValues/ParamValues 一一对应）。
parameter_class=input_control
type_list=string
default_type=string
sem_type=string
multivalue=true
parameter=InitialValues
description.ascii=参数初值元组（可为空，默认全 0）。
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=number
multivalue=true
parameter=XData
description.ascii=自变量数据元组。
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=number
multivalue=true
parameter=YData
description.ascii=因变量数据元组（与 XData 等长）。
parameter_class=input_control
type_list=realinteger
default_type=real
sem_type=number
multivalue=true
parameter=XName
description.ascii=表达式中自变量名（默认 x）。
parameter_class=input_control
type_list=string
default_value="x"
default_type=string
sem_type=string
multivalue=false
parameter=Threshold
description.ascii=内点残差阈值（几何距离，像素）。
parameter_class=input_control
type_list=realinteger
default_value=1.0
default_type=real
sem_type=number
multivalue=false
parameter=MaxIter
description.ascii=RANSAC 最大迭代次数。
parameter_class=input_control
type_list=integer
default_value=1000
default_type=integer
sem_type=number
multivalue=false
parameter=OutlierRatio
description.ascii=预估外点比例 [0,1)。
parameter_class=input_control
type_list=realinteger
default_value=0.2
default_type=real
sem_type=number
multivalue=false
parameter=ModelType
description.ascii=0=显式 y=f(x)，1=隐式 F(x,y)=0。
parameter_class=input_control
value_list=01
type_list=integer
default_value=0
default_type=integer
sem_type=number
multivalue=false
parameter=YName
description.ascii=表达式中因变量名（隐式模型必填）。
parameter_class=input_control
type_list=string
default_value="y"
default_type=string
sem_type=string
multivalue=false
parameter=MinSampleSize
description.ascii=每轮采样点数（0=自动取参数个数）。
parameter_class=input_control
type_list=integer
default_value=0
default_type=integer
sem_type=number
multivalue=false
parameter=Confidence
description.ascii=置信度（0,1），默认 0.99。
parameter_class=input_control
type_list=realinteger
default_value=0.99
default_type=real
sem_type=number
multivalue=false
parameter=Seed
description.ascii=随机种子（0=非确定）。
parameter_class=input_control
type_list=integer
default_value=0
default_type=integer
sem_type=number
multivalue=false
parameter=ParamValues
description.ascii=拟合参数输出元组。
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=true
parameter=InlierMask
description.ascii=内点掩码（1=内点）。
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=true
parameter=ResidualSum
description.ascii=内点残差平方和。
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=false
parameter=Iterations
description.ascii=迭代次数（≥1）。
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=Status
description.ascii=状态码（0=成功，负值见状态说明）。
parameter_class=output_control
type_list=integer
default_type=integer
sem_type=number
multivalue=false
parameter=StatusMessage
description.ascii=状态描述文本。
parameter_class=output_control
type_list=string
default_type=string
sem_type=string
multivalue=false
parameter=InlierRatio
description.ascii=内点比例输出。
parameter_class=output_control
type_list=real
default_type=real
sem_type=number
multivalue=false
