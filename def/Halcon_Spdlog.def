  default_type:       integer;
  multivalue:         false;
  sem_type:           number;
  type_list:          integer;
  default_value:      0;
  value_list:         0,1;

parameter
  handle:             output_control;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;


spdlog_rotating_logger_mt<- CHspdlog_rotating_logger_mt[::logger_name,filename,max_file_size,max_files:handle]
short.english
  创建滚动文件日志记录器(多线程安全)。当日志文件大小达到max_file_size字节时，自动创建新文件并对旧文件编号轮转，最多保留max_files个历史文件。适用于长时间运行的程序，防止单个日志文件过大。例如filename为app.log，轮转后生成app.1.log、app.2.log等。;
short.german
  Erstellt einen rotierenden Datei-Logger (Multi-Thread).;
