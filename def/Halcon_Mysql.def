  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  handle:             input_control;
  default_type:       handle;
  multivalue:         false;
  sem_type:           handle;
  type_list:          handle;

parameter
  result:             output_control;
  default_type:       string;
  multivalue:         true;
