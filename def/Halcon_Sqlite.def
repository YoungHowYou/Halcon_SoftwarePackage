sqlite3_open<- CHsqlite3_open[::filename:DbNumber]
short.german
  Laplace Filter.;
  
short.english
  Laplace Filter.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  filename:           input_control;
  description.english: 数据库文件路径（':memory:' 为内存库）。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;

parameter
  DbNumber:           output_control;
  description.english: 数据库连接句柄（sqlite3_open 的输出）。;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;


