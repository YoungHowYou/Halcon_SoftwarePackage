  Laplace Filter.;
  
short.english
  Laplace Filter.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  DbNumber:           input_control;
  description.english: 数据库连接句柄（sqlite3_open 的输出）。;
  default_type:       handle;
  multivalue:         false;
  sem_type:           handle;
  type_list:          handle;

parameter
  sql:                input_control;
  description.english: SQL 语句。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;

parameter
  table_names:        output_control;
  description.english: 结果表（按行展开的字符串元组）。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;

parameter
  X:                  output_control;
  description.english: 结果行数。;
  default_type:       integer;
  multivalue:         false;
  sem_type:           number;
  type_list:          integer;

parameter
  Y:                  output_control;
  description.english: 结果列数。;
  default_type:       integer;
  multivalue:         false;
  sem_type:           number;
  type_list:          integer;

parameter
  errmsg:             output_control;
  description.english: 错误消息输出。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;

