cv_geom_create<- CHcv_geom_create[::ModelExpression,XName,YName,ParamNames,ModelType,ResidualType:ModelHandle]
short.english
  构建 RANSAC 几何拟合模型：表达式白名单校验 + 预编译 + 最小采样数自动推导（只解析一次），返回可复用句柄。配合 cv_geom_fit 反复拟合、cv_fit_clear 释放。;

short.german
  Create a reusable RANSAC geometric fitting model handle (model expression validated and compiled once, minimum sample size derived automatically).;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Ransac, Fitting, Geometry, Model;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  ModelExpression:    input_control;
  description.english: 模型表达式：显式 y=f(x) 或隐式 F(x,y)=0（圆/椭圆/圆锥曲线）;
  default_type:       string;
  sem_type:           string;
  type_list:          string;
  multivalue:         false;
parameter
  XName:              input_control;
  description.english: 自变量名（如 x）;
  default_type:       string;
  sem_type:           string;
  type_list:          string;
  multivalue:         false;
parameter
  YName:              input_control;
  description.english: 纵坐标名（如 y，隐式模型必填）;
  default_type:       string;
  sem_type:           string;
  type_list:          string;
  multivalue:         false;
parameter
  ParamNames:         input_control;
  description.english: 参数名元组;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  ModelType:          input_control;
  description.english: 模型类型：explicit（y=f(x)）/ implicit（F(x,y)=0），大小写不敏感，也接受 0/1;
  default_type:       string;
  sem_type:           string;
  type_list:          string,integer;
  multivalue:         false;
parameter
  ResidualType:       input_control;
  description.english: 残差类型：vertical（|y-f(x)|，仅显式）/ geometric（几何距离，推荐），大小写不敏感，也接受 0/1;
  default_type:       string;
  sem_type:           string;
  type_list:          string,integer;
  multivalue:         false;
parameter
  ModelHandle:        output_control;
  description.english: 几何拟合模型句柄（cv_geom_fit 输入，cv_fit_clear 释放）;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
cv_geom_fit<- CHcv_geom_fit[::ModelHandle,XData,YData,InitialValues,Threshold,MaxIter,OutlierRatio,Confidence,Seed:ParamValues,InlierMask,ResidualSum,Iterations,Status,StatusMessage,InlierRatio]
short.english
  用 cv_geom_create 构建的模型句柄做 RANSAC 几何拟合（动态迭代 + LM 精化，零表达式解析开销）。;

short.german
  Fit data with a RANSAC geometric model handle previously created by cv_geom_create (dynamic iteration and LM refinement).;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Ransac, Fitting, Geometry, Model;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  ModelHandle:        input_control;
  description.english: cv_geom_create 生成的模型句柄;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
parameter
  XData:              input_control;
  description.english: 自变量观测数据元组;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  YData:              input_control;
  description.english: 纵坐标观测数据元组（长度须与 XData 一致）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  InitialValues:      input_control;
  description.english: 参数初值元组（长度=参数数，可为空取默认 0）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Threshold:          input_control;
  description.english: 内点几何距离阈值（>0）;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  MaxIter:            input_control;
  description.english: 最大迭代次数（>0）;
  default_type:       integer;
  sem_type:           integer;
  type_list:          integer;
  multivalue:         false;
parameter
  OutlierRatio:       input_control;
  description.english: 外点比例估计 [0,1);
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  Confidence:         input_control;
  description.english: 置信度 (0,1)，<=0 取 0.99;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  Seed:               input_control;
  description.english: 随机种子（0=非确定性）;
  default_type:       integer;
  sem_type:           integer;
  type_list:          integer;
  multivalue:         false;
parameter
  ParamValues:        output_control;
  description.english: 拟合参数值元组;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real;
parameter
  InlierMask:         output_control;
  description.english: 内点掩码（1=内点，逐点输出）;
  default_type:       integer;
  multivalue:         true;
  sem_type:           integer;
  type_list:          integer;
parameter
  ResidualSum:        output_control;
  description.english: 内点（加权）残差平方和;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  Iterations:         output_control;
  description.english: 实际迭代次数;
  default_type:       integer;
  sem_type:           integer;
  type_list:          integer;
  multivalue:         false;
parameter
  Status:             output_control;
  description.english: 状态码（0=成功，负值见算子文档）;
  default_type:       integer;
  sem_type:           integer;
  type_list:          integer;
  multivalue:         false;
parameter
  StatusMessage:      output_control;
  description.english: 状态描述文本;
  default_type:       string;
  sem_type:           string;
  type_list:          string;
  multivalue:         false;
parameter
  InlierRatio:        output_control;
  description.english: 内点比例;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;

