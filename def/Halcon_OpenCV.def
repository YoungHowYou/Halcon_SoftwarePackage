write_image_exif<- CWriteImageExif[::image_path,latitude,longitude,altitude,aperture,shutter_speed,iso_number,focal_length,date_time,camera_make,camera_model:]
short.german
  Write EXIF metadata to image file.;
  
short.english
  Write EXIF metadata to image file.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, EXIF, Metadata, GPS;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image_path:         input_control;
  default_type:       string;
  multivalue:         false;
  sem_type:           filename;
  type_list:          string;

parameter
  latitude:           input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  longitude:          input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  altitude:           input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  aperture:           input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  shutter_speed:      input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  iso_number:         input_control;
  default_type:       integer;
  multivalue:         false;
  sem_type:           number;
  type_list:          integer;
  default_value:      100;

parameter
  focal_length:       input_control;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  date_time:          input_control;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "";

parameter
  camera_make:        input_control;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "Camera";

parameter
  camera_model:       input_control;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "Model";

