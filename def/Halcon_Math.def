cv_lm_create<- CHcv_lm_create[::Expressions,ParamNames,XNames:ModelHandle]
short.english
  构建 LM 非线性拟合模型：一次性校验并编译表达式（muparser 整个生命周期只解析这一次），返回可复用的拟合模型句柄。配合 cv_lm_fit 反复拟合、cv_fit_clear 释放。;
parameter
  Expressions:        input_control;
  description.english: 输出表达式元组（1~K 个，共享同一组参数，如畸变场 [dx模型,dy模型]）;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  ParamNames:         input_control;
  description.english: 共享参数名元组（建模时做查重/冲突校验）;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  XNames:             input_control;
  description.english: 自变量名元组（1~M 个，M=1 即一维拟合）;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  ModelHandle:        output_control;
  description.english: 拟合模型句柄（cv_lm_fit 输入，cv_fit_clear 释放）;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
cv_lm_fit<- CHcv_lm_fit[::ModelHandle,X,Y,Z,InitialValues,MaxIter,Eps:ParamValues,RSS,Iterations,Status,StatusMessage]
short.english
  用 cv_lm_create 构建的模型句柄做 LM 非线性最小二乘拟合（零表达式解析开销）。单输出(K=1)：M=1 传 X+Y、M=2 传 X,Y+Z；多输出(K>1)：X=自变量拉平(点数×M)、Y=观测拉平(点数×K)、Z 传空。;
parameter
  ModelHandle:        input_control;
  description.english: cv_lm_create 生成的模型句柄;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
parameter
  X:                  input_control;
  description.english: 自变量数据（K=1,M=1 时为自变量；K>1 时为自变量拉平 点数×M）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Y:                  input_control;
  description.english: 观测数据（K=1,M=1 时为观测；K=1,M=2 时为第 2 自变量；K>1 时为观测拉平 点数×K）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Z:                  input_control;
  description.english: 观测数据（仅 K=1,M=2 时使用；其余模式传空元组）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  InitialValues:      input_control;
  description.english: 参数初值元组（长度=参数数）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  MaxIter:            input_control;
  description.english: 最大函数求值次数（<=0 取 400*(n+1)）;
  default_type:       integer;
  sem_type:           integer;
  type_list:          integer;
  multivalue:         false;
parameter
  Eps:                input_control;
  description.english: 数值微分步长（<=0 由 Eigen 自动选取）;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  ParamValues:        output_control;
  description.english: 拟合后的参数值元组;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
parameter
  RSS:                output_control;
  description.english: 残差平方和（表达式出错时为 -1）;
  default_type:       real;
  sem_type:           real;
  multivalue:         false;
parameter
  Iterations:         output_control;
  description.english: LM 迭代次数;
  default_type:       integer;
  sem_type:           integer;
  multivalue:         false;
parameter
  Status:             output_control;
  description.english: Eigen LM 状态码;
  default_type:       integer;
  sem_type:           integer;
  multivalue:         false;
parameter
  StatusMessage:      output_control;
  description.english: 状态描述文本;
  default_type:       string;
  sem_type:           string;
  multivalue:         false;
cv_linear_create<- CHcv_linear_create[::Expression,ParamNames,XNames:ModelHandle]
short.english
  构建线性最小二乘拟合模型：一次性校验并编译表达式（只解析一次），返回可复用句柄。XNames 1 个=一维、2 个=二维。配合 cv_linear_fit、cv_fit_clear。;
parameter
  Expression:         input_control;
  description.english: 模型表达式（单输出，对参数必须线性，自变量可非线性）;
  default_type:       string;
  sem_type:           string;
  type_list:          string;
  multivalue:         false;
parameter
  ParamNames:         input_control;
  description.english: 参数名元组（建模时做查重/冲突校验）;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  XNames:             input_control;
  description.english: 自变量名元组（1~2 个）;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
parameter
  ModelHandle:        output_control;
  description.english: 拟合模型句柄（cv_linear_fit 输入，cv_fit_clear 释放）;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
cv_linear_fit<- CHcv_linear_fit[::ModelHandle,X,Y,Z,Tolerance:Coefficients,RSS,Rank,Success,Message]
short.english
  用 cv_linear_create 构建的模型句柄做线性最小二乘拟合（列主元 QR + 对参数线性校验，零解析开销）。一维传 X,Y（Z 空）；二维传 X,Y,Z。;
parameter
  ModelHandle:        input_control;
  description.english: cv_linear_create 生成的模型句柄;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
parameter
  X:                  input_control;
  description.english: 自变量数据（一维时唯一的自变量；二维时第 1 自变量）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Y:                  input_control;
  description.english: 一维时为观测数据，二维时为第 2 自变量;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Z:                  input_control;
  description.english: 二维时的观测数据（一维传空元组）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
  type_list:          real,integer;
parameter
  Tolerance:          input_control;
  description.english: 线性校验容差（<=0 取 1e-10）;
  default_type:       real;
  sem_type:           real;
  type_list:          real;
  multivalue:         false;
parameter
  Coefficients:       output_control;
  description.english: 拟合系数元组（与 ParamNames 同序）;
  default_type:       real;
  multivalue:         true;
  sem_type:           real;
parameter
  RSS:                output_control;
  description.english: 残差平方和（失败为 -1）;
  default_type:       real;
  sem_type:           real;
  multivalue:         false;
parameter
  Rank:               output_control;
  description.english: 设计矩阵数值秩;
  default_type:       integer;
  sem_type:           integer;
  multivalue:         false;
parameter
  Success:            output_control;
  description.english: 拟合成功标志（1/0）;
  default_type:       integer;
  sem_type:           integer;
  multivalue:         false;
parameter
  Message:            output_control;
  description.english: 结果描述文本;
  default_type:       string;
  sem_type:           string;
  multivalue:         false;
cv_fit_clear<- CHcv_fit_clear[::ModelHandle:]
short.english
  显式释放拟合模型句柄占用的原生资源（表达式编译产物等）。句柄随后不可再用于拟合；模型内存立即释放，句柄壳由 HALCON 句柄 GC 回收。;
parameter
  ModelHandle:        input_control;
  description.english: cv_lm_create / cv_linear_create / cv_geom_create 生成的句柄;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;
/*=============================================================================
 * Halcon_Math.def — HALCON 数学/矩阵扩展算子定义
 *===========================================================================*/

std_nth_element<- Cstd_nth_element[image::nIndex:value]
short.german
  Find the n-th smallest element using std::nth_element.;

short.english
  Find the n-th smallest element (flattened, 0-based) using std::nth_element.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Sort, NthElement, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  sem_type:           image;
  multivalue:         optional;

parameter
  nIndex:            input_control;
  description.german:  Index des gesuchten Elementes (0-basiert, nach dem Flachlegen).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  value:             output_control;
  description.german:  Wert des n-ten Elementes.;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;


std_sort<- Cstd_sort[image:imageOut:descending:]
short.german
  Sort image elements using std::sort.;

short.english
  Sort image elements (flattened) using std::sort.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Sort, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageOut:          output_object;
  description.german:  Sortiertes Bild, gleiche Groesse wie das Eingabebild.;
  sem_type:           image;
  multivalue:         optional;

parameter
  descending:        input_control;
  description.german:  Sortierrichtung: 0 = aufsteigend, 1 = absteigend.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;


std_lower_bound<- Cstd_lower_bound[image::value:index]
short.german
