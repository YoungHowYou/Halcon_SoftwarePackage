std_nth_element<- Cstd_nth_element[image::nIndex:value]
short.german
  Find the n-th smallest element using std::nth_element.;

short.english
  Find the n-th smallest element (flattened, 0-based) using std::nth_element.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Sort, NthElement, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  sem_type:           image;
  multivalue:         optional;

parameter
  nIndex:            input_control;
  description.german:  Index des gesuchten Elementes (0-basiert, nach dem Flachlegen).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  value:             output_control;
  description.german:  Wert des n-ten Elementes.;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;


