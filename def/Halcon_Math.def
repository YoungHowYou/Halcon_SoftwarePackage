parameter
  descending:        input_control;
  description.german:  Sortierrichtung: 0 = aufsteigend, 1 = absteigend.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;


