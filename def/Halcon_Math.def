std_nth_element<- Cstd_nth_element[image::nIndex:value]
short.german
  Find the n-th smallest element using std::nth_element.;

short.english
  Find the n-th smallest element (flattened, 0-based) using std::nth_element.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Sort, NthElement, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  description.english: Input image (real, single channel).;
  sem_type:           image;
  multivalue:         optional;

parameter
  nIndex:            input_control;
  description.german:  Index des gesuchten Elementes (0-basiert, nach dem Flachlegen).;
  description.english: Index of the wanted element (0-based, after flattening).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  value:             output_control;
  description.german:  Wert des n-ten Elementes.;
  description.english: Value of the n-th smallest element.;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;


std_sort<- Cstd_sort[image:imageOut:descending:]
short.german
  Sort image elements using std::sort.;

short.english
  Sort image elements (flattened) using std::sort.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Sort, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  description.english: Input image (real, single channel).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageOut:          output_object;
  description.german:  Sortiertes Bild, gleiche Groesse wie das Eingabebild.;
  description.english: Sorted image, same size as the input image.;
  sem_type:           image;
  multivalue:         optional;

parameter
  descending:        input_control;
  description.german:  Sortierrichtung: 0 = aufsteigend, 1 = absteigend.;
  description.english: Sort order: 0 = ascending, 1 = descending.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;


std_lower_bound<- Cstd_lower_bound[image::value:index]
short.german
  Binary search lower bound using std::lower_bound.;

short.english
  Binary search lower bound (input must be sorted ascending) using std::lower_bound.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, BinarySearch, LowerBound, Std;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  image:             input_object;
  description.german:  Aufsteigend sortiertes Eingabebild (real, einkanalig).;
  description.english: Ascending input image (real, single channel, must be sorted).;
  sem_type:           image;
  multivalue:         optional;

parameter
  value:             input_control;
  description.german:  Suchwert.;
  description.english: Value to search for.;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     0.0;

parameter
  index:             output_control;
  description.german:  Index des ersten Elementes groesser oder gleich Value.;
  description.english: Index of the first element not less than Value.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;


eigen_svd<- Ceigen_svd[imageA:imageU,imageS,imageV::]
short.german
  Singular value decomposition using Eigen (JacobiSVD).;

short.english
  Singular value decomposition (JacobiSVD) using Eigen.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, SVD, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  imageA:            input_object;
  description.german:  Eingabematrix A (real, Hoehe = Zeilen, Breite = Spalten).;
  description.english: Input matrix A (real, height = rows, width = columns).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageU:            output_object;
  description.german:  Linke Singulaervektormatrix U (m x m).;
  description.english: Left singular vector matrix U (m x m).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageS:            output_object;
  description.german:  Singulaerwerte als Zeilenvektor (1 x min(m,n)), absteigend.;
  description.english: Singular values as row vector (1 x min(m,n)), in descending order.;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageV:            output_object;
  description.german:  Rechte Singulaervektormatrix V (n x n).;
  description.english: Right singular vector matrix V (n x n).;
  sem_type:           image;
  multivalue:         optional;


eigen_ldlt<- Ceigen_ldlt[imageA,imageB:imageX::]
short.german
  Solve symmetric linear equations using Eigen (LDLT).;

short.english
  Solve symmetric linear equations A*x=b using Eigen LDLT.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, LDLT, Linear, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  imageA:            input_object;
  description.german:  Symmetrische Eingabematrix A (real, quadratisch).;
  description.english: Symmetric input matrix A (real, square).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageB:            input_object;
  description.german:  Rechte Seite b (real, Hoehe = Zeilen von A, Breite = 1).;
  description.english: Right hand side b (real, height = rows of A, width = 1).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageX:            output_object;
  description.german:  Loesungsvektor x (real).;
  description.english: Solution vector x (real).;
  sem_type:           image;
  multivalue:         optional;


