  imageA:            input_object;
  description.german:  Symmetrische Eingabematrix A (real, quadratisch).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageB:            input_object;
  description.german:  Rechte Seite b (real, Hoehe = Zeilen von A, Breite = 1).;
