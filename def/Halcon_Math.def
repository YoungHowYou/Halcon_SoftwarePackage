arma_interp1<- Carma_interp1[imageX,imageY,imageXI:imageYI:interpMethod:]
short.german
  One-dimensional interpolation using Armadillo (interp1).;

short.english
  One-dimensional interpolation using Armadillo interp1.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Interp1, Interpolation, Armadillo;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  imageX:            input_object;
  description.german:  Stuetzstellen X (real, 1 x N oder N x 1), aufsteigend.;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageY:            input_object;
  description.german:  Stuetzwerte Y (real, gleiche Laenge wie X).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageXI:           input_object;
  description.german:  Abfragepunkte XI (real, 1 x M oder M x 1).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageYI:           output_object;
  description.german:  Interpolierte Werte YI (real, gleiche Laenge wie XI).;
  sem_type:           image;
  multivalue:         optional;

parameter
  interpMethod:      input_control;
  description.german:  Interpolationsverfahren: linear oder nearest (nur der erste Buchstabe wird ausgewertet). Ein fuehrendes Sternchen setzt monotone X und XI voraus.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "linear";


eigen_lm_fit<- Ceigen_lm_fit[::modelExpression,paramNames,initialValues,xData,yData,xName,maxIter,eps:paramValues,rss,iterations,status,statusMessage]
short.german
  Nonlinear least-squares curve fitting with Eigen LevenbergMarquardt (runtime model expression).;

short.english
  Fit a user-supplied model expression to data using the Eigen LevenbergMarquardt algorithm.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LevenbergMarquardt, Optimization, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  modelExpression:   input_control;
  description.german:  Modellausdruck, z.B. a*exp(b*x)+c.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "a*x+b";

parameter
  paramNames:        input_control;
  description.german:  Namen der anzupassenden Parameter, z.B. a,b,c.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  initialValues:     input_control;
  description.german:  Startwerte der Parameter, Laenge muss der Anzahl von ParamNames entsprechen.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xData:             input_control;
  description.german:  Stuetzstellen der unabhaengigen Variablen.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.german:  Stuetzstellen der abhaengigen Variablen, Laenge muss der Anzahl von XData entsprechen.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xName:             input_control;
  description.german:  Name der unabhaengigen Variablen im Modellausdruck (Standard: x).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "x";

parameter
  maxIter:           input_control;
  description.german:  Maximale Anzahl der Funktionsaufrufe (0 = 400*(Anzahl Parameter+1)).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  eps:               input_control;
  description.german:  Schrittweite der numerischen Differentiation (0 = automatisch).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     0.0;

parameter
  paramValues:       output_control;
  description.german:  Angepasste Parameterwerte in der Reihenfolge von ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.german:  Summe der Fehlerquadrate (-1 bei Ausdrucksfehler).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  iterations:        output_control;
  description.german:  Anzahl der durchgefuehrten Iterationen.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  status:            output_control;
  description.german:  Statuscode des LevenbergMarquardt-Algorithmus (1-4 konvergiert, 5-8 beendet, 0 fehlgeschlagen).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.german:  Statustext des Ergebnisses (bei Ausdrucksfehler mit expression error: ...).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;


eigen_lm_fit_2d<- Ceigen_lm_fit_2d[::expressions,paramNames,initialValues,xNames,xData,yData,maxIter,eps:paramValues,rss,iterations,status,statusMessage]
short.german
  Nichtlineare Ausgleichsrechnung mit mehreren Variablen und gemeinsamen Parametern (Eigen LevenbergMarquardt).;

short.english
  Multi-variable multi-output nonlinear least-squares fit with shared parameters using Eigen LevenbergMarquardt.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LevenbergMarquardt, Optimization, Eigen, Distortion;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  expressions:       input_control;
  description.german:  Modellausdruecke (einer oder mehr), z.B. je einer fuer dx und dy. Alle teilen sich ParamNames.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  paramNames:        input_control;
  description.german:  Namen der gemeinsamen Parameter, z.B. k1,k2,k3,p1,p2.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  initialValues:     input_control;
  description.german:  Startwerte der Parameter, Laenge muss der Anzahl von ParamNames entsprechen.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xNames:            input_control;
  description.german:  Namen der unabhaengigen Variablen (eine oder mehr), z.B. u,v. Ableitungen wie r2=u^2+v^2 duerfen vorab berechnet mitgegeben werden.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  xData:             input_control;
  description.german:  Werte der unabhaengigen Variablen, Laenge = Anzahl Punkte mal Anzahl XNames (pro Punkt M Werte).;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.german:  Beobachtete Werte, Laenge = Anzahl Punkte mal Anzahl Expressions (pro Punkt K Werte).;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  maxIter:           input_control;
  description.german:  Maximale Anzahl der Funktionsaufrufe (0 = 400*(Anzahl Parameter+1)).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  eps:               input_control;
  description.german:  Schrittweite der numerischen Differentiation (0 = automatisch).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     0.0;

parameter
  paramValues:       output_control;
  description.german:  Angepasste Parameterwerte in der Reihenfolge von ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.german:  Summe der Fehlerquadrate aller Ausgaenge (-1 bei Ausdrucksfehler).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  iterations:        output_control;
  description.german:  Anzahl der durchgefuehrten Iterationen.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  status:            output_control;
  description.german:  Statuscode des LevenbergMarquardt-Algorithmus (1-4 konvergiert, 5-8 beendet, 0 fehlgeschlagen).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.german:  Statustext des Ergebnisses (bei Ausdrucksfehler mit expression error: ...).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;


linear_fit<- Clinear_fit[::modelExpression,paramNames,xData,yData,xName,linearTolerance:paramValues,rss,rank,success,statusMessage]
short.german
  Lineare Ausgleichsrechnung mit Eigen ColPivHouseholderQR (Laufzeit-Modellausdruck).;

short.english
  Fit a linear-in-parameters model expression to data using Eigen ColPivHouseholderQR.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LinearLeastSquares, QR, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  modelExpression:   input_control;
  description.english: Model expression, linear in parameters, e.g. a+b*x+c*x*x.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "a*x+b";

parameter
  paramNames:        input_control;
  description.english: Names of the parameters to fit, e.g. a,b,c. Must be unique and differ from XName.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  xData:             input_control;
  description.english: Samples of the independent variable.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.english: Samples of the dependent variable. Length must equal the number of XData.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xName:             input_control;
  description.english: Name of the independent variable used in the model expression (default: x).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "x";

parameter
  linearTolerance:   input_control;
  description.english: Tolerance for the parameter-linearity verification (default: 1e-10).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     1.0e-10;

parameter
  paramValues:       output_control;
  description.english: Fitted parameter values, ordered like ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.english: Residual sum of squares (-1 on failure).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  rank:              output_control;
  description.english: Rank of the design matrix.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  success:           output_control;
  description.english: 1 if the fit succeeded, 0 otherwise.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.english: Status text of the result.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;


linear_fit_2d<- Clinear_fit_2d[::modelExpression,paramNames,xData,yData,zData,linearTolerance:paramValues,rss,rank,success,statusMessage]
short.german
  Lineare Ausgleichsrechnung mit zwei unabhaengigen Variablen (Eigen ColPivHouseholderQR).;

short.english
  Fit a linear-in-parameters model with two independent variables using Eigen ColPivHouseholderQR.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LinearLeastSquares, QR, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  modelExpression:   input_control;
  description.english: Model expression, linear in parameters, e.g. a+b*x+c*y+d*x*y. Independent variables are named x and y.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "a+b*x+c*y";

parameter
  paramNames:        input_control;
  description.english: Names of the parameters to fit, e.g. a,b,c,d. Must be unique and differ from x,y.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  xData:             input_control;
  description.english: Samples of the independent variable x.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.english: Samples of the independent variable y.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  zData:             input_control;
  description.english: Observed values of the dependent variable z. Length must equal the number of XData/YData.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  linearTolerance:   input_control;
  description.english: Tolerance for the parameter-linearity verification (default: 1e-10).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     1.0e-10;

parameter
  paramValues:       output_control;
  description.english: Fitted parameter values, ordered like ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.english: Residual sum of squares (-1 on failure).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  rank:              output_control;
  description.english: Rank of the design matrix.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  success:           output_control;
  description.english: 1 if the fit succeeded, 0 otherwise.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.english: Status text of the result.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
