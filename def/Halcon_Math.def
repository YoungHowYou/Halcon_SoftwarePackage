arma_interp1<- Carma_interp1[imageX,imageY,imageXI:imageYI:interpMethod:]
short.german
  One-dimensional interpolation using Armadillo (interp1).;

short.english
  One-dimensional interpolation using Armadillo interp1.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Interp1, Interpolation, Armadillo;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  imageX:            input_object;
  description.german:  Stuetzstellen X (real, 1 x N oder N x 1), aufsteigend.;
  description.english: Sample points X (real, 1 x N or N x 1), ascending.;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageY:            input_object;
  description.german:  Stuetzwerte Y (real, gleiche Laenge wie X).;
  description.english: Sample values Y (real, same length as X).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageXI:           input_object;
  description.german:  Abfragepunkte XI (real, 1 x M oder M x 1).;
  description.english: Query points XI (real, 1 x M or M x 1).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageYI:           output_object;
  description.german:  Interpolierte Werte YI (real, gleiche Laenge wie XI).;
  description.english: Interpolated values YI (real, same length as XI).;
  sem_type:           image;
  multivalue:         optional;

parameter
  interpMethod:      input_control;
  description.german:  Interpolationsverfahren: linear oder nearest (nur der erste Buchstabe wird ausgewertet). Ein fuehrendes Sternchen setzt monotone X und XI voraus.;
  description.english: Interpolation method, either linear or nearest (only the first letter is evaluated). A leading asterisk assumes monotonic X and XI.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "linear";


eigen_lm_fit<- Ceigen_lm_fit[::modelExpression,paramNames,initialValues,xData,yData,xName,maxIter,eps:paramValues,rss,iterations,status,statusMessage]
short.german
  Nonlinear least-squares curve fitting with Eigen LevenbergMarquardt (runtime model expression).;

short.english
  Fit a user-supplied model expression to data using the Eigen LevenbergMarquardt algorithm.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LevenbergMarquardt, Optimization, Eigen;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  modelExpression:   input_control;
  description.german:  Modellausdruck, z.B. a*exp(b*x)+c.;
  description.english: Model expression to fit, e.g. a*exp(b*x)+c.;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "a*x+b";

parameter
  paramNames:        input_control;
  description.german:  Namen der anzupassenden Parameter, z.B. a,b,c.;
  description.english: Names of the parameters to fit, e.g. a,b,c. Must be unique and differ from XName.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  initialValues:     input_control;
  description.german:  Startwerte der Parameter, Laenge muss der Anzahl von ParamNames entsprechen.;
  description.english: Initial parameter values. Length must equal the number of ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xData:             input_control;
  description.german:  Stuetzstellen der unabhaengigen Variablen.;
  description.english: Samples of the independent variable.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.german:  Stuetzstellen der abhaengigen Variablen, Laenge muss der Anzahl von XData entsprechen.;
  description.english: Samples of the dependent variable. Length must equal the number of XData.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xName:             input_control;
  description.german:  Name der unabhaengigen Variablen im Modellausdruck (Standard: x).;
  description.english: Name of the independent variable used in the model expression (default: x).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
  default_value:     "x";

parameter
  maxIter:           input_control;
  description.german:  Maximale Anzahl der Funktionsaufrufe (0 = 400*(Anzahl Parameter+1)).;
  description.english: Maximum number of function evaluations (0 selects 400*(numParams+1)).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  eps:               input_control;
  description.german:  Schrittweite der numerischen Differentiation (0 = automatisch).;
  description.english: Step size for numerical differentiation (0 selects it automatically).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     0.0;

parameter
  paramValues:       output_control;
  description.german:  Angepasste Parameterwerte in der Reihenfolge von ParamNames.;
  description.english: Fitted parameter values, ordered like ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.german:  Summe der Fehlerquadrate (-1 bei Ausdrucksfehler).;
  description.english: Residual sum of squares (-1 if the expression could not be evaluated).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  iterations:        output_control;
  description.german:  Anzahl der durchgefuehrten Iterationen.;
  description.english: Number of iterations performed.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  status:            output_control;
  description.german:  Statuscode des LevenbergMarquardt-Algorithmus (1-4 konvergiert, 5-8 beendet, 0 fehlgeschlagen).;
  description.english: LevenbergMarquardt status code (1-4 converged, 5-8 finished without confirmation, 0 failed).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.german:  Statustext des Ergebnisses (bei Ausdrucksfehler mit expression error: ...).;
  description.english: Status text of the result (contains expression error: ... on failure).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;


eigen_lm_fit_2d<- Ceigen_lm_fit_2d[::expressions,paramNames,initialValues,xNames,xData,yData,maxIter,eps:paramValues,rss,iterations,status,statusMessage]
short.german
  Nichtlineare Ausgleichsrechnung mit mehreren Variablen und gemeinsamen Parametern (Eigen LevenbergMarquardt).;

short.english
  Multi-variable multi-output nonlinear least-squares fit with shared parameters using Eigen LevenbergMarquardt.;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, Fitting, LevenbergMarquardt, Optimization, Eigen, Distortion;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  expressions:       input_control;
  description.german:  Modellausdruecke (einer oder mehr), z.B. je einer fuer dx und dy. Alle teilen sich ParamNames.;
  description.english: One or more model expressions, e.g. one for dx and one for dy. All of them share ParamNames.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  paramNames:        input_control;
  description.german:  Namen der gemeinsamen Parameter, z.B. k1,k2,k3,p1,p2.;
  description.english: Names of the shared parameters, e.g. k1,k2,k3,p1,p2. Must be unique and differ from XNames.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  initialValues:     input_control;
  description.german:  Startwerte der Parameter, Laenge muss der Anzahl von ParamNames entsprechen.;
  description.english: Initial parameter values. Length must equal the number of ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  xNames:            input_control;
  description.german:  Namen der unabhaengigen Variablen (eine oder mehr), z.B. u,v. Ableitungen wie r2=u^2+v^2 duerfen vorab berechnet mitgegeben werden.;
  description.english: One or more independent variable names, e.g. u,v. Precomputed terms such as r2=u^2+v^2 may be passed as extra variables.;
  default_type:      string;
  multivalue:        true;
  sem_type:          string;
  type_list:         string;

parameter
  xData:             input_control;
  description.german:  Werte der unabhaengigen Variablen, Laenge = Anzahl Punkte mal Anzahl XNames (pro Punkt M Werte).;
  description.english: Independent variable samples, length = numPoints * numXNames (M values per point, row major).;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  yData:             input_control;
  description.german:  Beobachtete Werte, Laenge = Anzahl Punkte mal Anzahl Expressions (pro Punkt K Werte).;
  description.english: Observed values, length = numPoints * numExpressions (K values per point, row major).;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  maxIter:           input_control;
  description.german:  Maximale Anzahl der Funktionsaufrufe (0 = 400*(Anzahl Parameter+1)).;
  description.english: Maximum number of function evaluations (0 selects 400*(numParams+1)).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;
  default_value:     0;

parameter
  eps:               input_control;
  description.german:  Schrittweite der numerischen Differentiation (0 = automatisch).;
  description.english: Step size for numerical differentiation (0 selects it automatically).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;
  default_value:     0.0;

parameter
  paramValues:       output_control;
  description.german:  Angepasste Parameterwerte in der Reihenfolge von ParamNames.;
  description.english: Fitted parameter values, ordered like ParamNames.;
  default_type:      real;
  multivalue:        true;
  sem_type:          number;
  type_list:         real;

parameter
  rss:               output_control;
  description.german:  Summe der Fehlerquadrate aller Ausgaenge (-1 bei Ausdrucksfehler).;
  description.english: Residual sum of squares over all outputs (-1 if the expression could not be evaluated).;
  default_type:      real;
  multivalue:        false;
  sem_type:          number;
  type_list:         real;

parameter
  iterations:        output_control;
  description.german:  Anzahl der durchgefuehrten Iterationen.;
  description.english: Number of iterations performed.;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  status:            output_control;
  description.german:  Statuscode des LevenbergMarquardt-Algorithmus (1-4 konvergiert, 5-8 beendet, 0 fehlgeschlagen).;
  description.english: LevenbergMarquardt status code (1-4 converged, 5-8 finished without confirmation, 0 failed).;
  default_type:      integer;
  multivalue:        false;
  sem_type:          number;
  type_list:         integer;

parameter
  statusMessage:     output_control;
  description.german:  Statustext des Ergebnisses (bei Ausdrucksfehler mit expression error: ...).;
  description.english: Status text of the result (contains expression error: ... on failure).;
  default_type:      string;
  multivalue:        false;
  sem_type:          string;
  type_list:         string;
