  method:              none;

parameter
  image:             input_object;
  description.german:  Eingabebild (real, einkanalig).;
  sem_type:           image;
  multivalue:         optional;

parameter
  imageOut:          output_object;
  description.german:  Sortiertes Bild, gleiche Groesse wie das Eingabebild.;
  sem_type:           image;
