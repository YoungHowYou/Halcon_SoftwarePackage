  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, CVRegion, BinToRegion, Image;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  BinImage:          input_object;
  description.english: 输入数值类型图像（byte/int1/int2/uint2/int4/int8/real 单通道）。;
  sem_type:           image;
  multivalue:         optional;

parameter
  Region:            output_object;
  description.english: 输入 region。;
  sem_type:           region;
  multivalue:         optional;

parameter
  Threshold:         input_control;
  description.english: 前景阈值（gray ≥ Threshold 为前景），实数或整数。;
  default_type:       real;
  multivalue:         false;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      1.0;

value_number:
  Region == BinImage;


