cv_union2<- CHcv_union2[Region1,Region2:RegionUnion::]
short.german
  Vereinigung zweier Regionen pro Index (cv_region).;

short.english
  两个 region 求并集，对应 HALCON union2（RLE 有序归并）。结果去重合并相邻 run。;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, CVRegion, Union;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Region1:           input_object;
  description.english: 输入 region 1。;
  sem_type:           region;
  multivalue:         optional;

parameter
  Region2:           input_object;
  description.english: 输入 region 2。;
  sem_type:           region;
  multivalue:         optional;

parameter
  RegionUnion:        output_object;
  description.english: 输出并集 region。;
  sem_type:           region;
  multivalue:         optional;

value_number:
  RegionUnion == Region1 && (Region2 == Region1 || Region2 == 1);


