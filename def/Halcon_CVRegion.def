keywords.english
  UserExtensions, CVRegion, Select, Shape;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Regions:           input_object;
  description.english: 输入 region 元组，逐元素计算。;
  sem_type:           region;
  multivalue:         optional;

parameter
  SelectedRegions:    output_object;
  description.english: 输出筛选通过的 region 子集（引用语义）。;
  sem_type:           region;
  multivalue:         optional;

parameter
  Features:          input_control;
  description.english: 特征名元组（如 area/circularity，见 cvr_get_feature）。;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
  default_value:      "area";
  value_list:         area,row,column,width,height,ratio,row1,column1,row2,column2,circularity,compactness,convexity,rectangularity,contlength,phi,ra,rb,anisometry,bulkiness,struct_factor,structure_factor,outer_radius,max_diameter,dist_mean,dist_deviation,roundness,num_sides,orientation,connect_num,holes_num,area_holes,euler_number,rect2_phi,rect2_len1,rect2_len2,moments_m11,moments_m20,moments_m02,moments_ia,moments_ib,moments_m11_invar,moments_m20_invar,moments_m02_invar,moments_phi1,moments_phi2,moments_m21,moments_m12,moments_m03,moments_m30,moments_m21_invar,moments_m12_invar,moments_m03_invar,moments_m30_invar;

parameter
  Operation:         input_control;
  description.english: 组合方式：'and'（全部满足）/ 'or'（任一满足）。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "and";
  value_list:         and,or;

parameter
  Min:               input_control;
  description.english: 特征下限元组（与 Features 一一对应）。;
  default_type:       real;
  multivalue:         true;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  Max:               input_control;
  description.english: 特征上限元组（与 Features 一一对应）。;
  default_type:       real;
  multivalue:         true;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      10000.0;

value_number:
  SelectedRegions <= Regions;


