  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, CVRegion, Connection, Cache, Features;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Region:            input_object;
  description.english: 输入 region。;
  sem_type:           region;
  multivalue:         optional;

parameter
  ConnectedRegions:   output_object;
  description.english: 输出连通域元组。;
  sem_type:           region;
  multivalue:         optional;

parameter
  CacheFeatures:     input_control;
  description.english: 需要预先计算并缓存的特征名元组；none/basic/cheap/hull/all 为组合名，元素内可用 '|' 拼接，缺省 none 表示不做预计算。;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
  default_value:      "none";
  value_list:         none,basic,cheap,hull,all,area,center,row,column,bbox,rectangle1,width,height,rect2,rectangle2,circle,contlength,convexity,circularity,compactness,rectangularity,moments,elliptic_axis,ra,rb,phi,anisometry,bulkiness,structure_factor;

value_number:
  ConnectedRegions >= 0;


cv_select_shape<- CHcv_select_shape[Regions:SelectedRegions:Features,Operation,Min,Max:]
short.german
  Auswahl von Regionen anhand von Formmerkmalen (cv_region).;

short.english
  按形状特征筛选 region 子集，对应 HALCON select_shape。Features 为多特征名元组（可用名称与 cv_region_features 完全一致，含 ratio/outer_radius/dist_mean/max_diameter/connect_num/holes_num/area_holes/euler_number/rect2_phi/rect2_len1/rect2_len2 与 moments_* 系列），Operation 为 and/or，Min/Max 为阈值范围；输出保持引用语义。;

