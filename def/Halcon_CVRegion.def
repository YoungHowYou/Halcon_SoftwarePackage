parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Region1:           input_object;
  description.english: 输入 region 1。;
  sem_type:           region;
  multivalue:         optional;

parameter
  Region2:           input_object;
  description.english: 输入 region 2。;
  sem_type:           region;
  multivalue:         optional;

parameter
  RegionDifference:   output_object;
  description.english: 输出差集 region。;
  sem_type:           region;
  multivalue:         optional;

value_number:
  RegionDifference == Region1 && (Region2 == Region1 || Region2 == 1);


