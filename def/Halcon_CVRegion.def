cv_select_shape<- CHcv_select_shape[Regions:SelectedRegions:Features,Operation,Min,Max:]
short.german
  Auswahl von Regionen anhand von Formmerkmalen (cv_region).;

short.english
  按形状特征筛选 region 子集，对应 HALCON select_shape。Features 为多特征名元组，Operation 为 and/or，Min/Max 为阈值范围；输出保持引用语义。;

module
  foundation;

chapter.german
  BenutzerErweiterungen;

chapter.english
  UserExtensions;

keywords.english
  UserExtensions, CVRegion, Select, Shape;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Regions:           input_object;
  description.english: 输入 region 元组，逐元素计算。;
  sem_type:           region;
  multivalue:         optional;

parameter
  SelectedRegions:    output_object;
  description.english: 输出筛选通过的 region 子集（引用语义）。;
  sem_type:           region;
  multivalue:         optional;

parameter
  Features:          input_control;
  description.english: 特征名元组（如 area/circularity，见 cvr_get_feature）。;
  default_type:       string;
  multivalue:         true;
  sem_type:           string;
  type_list:          string;
  default_value:      "area";
  value_list:         "area","row","column","width","height","row1","column1","row2","column2","circularity","compactness","convexity","rectangularity","contlength","phi","ra","rb","anisometry","bulkiness","structure_factor";

parameter
  Operation:         input_control;
  description.english: 组合方式：'and'（全部满足）/ 'or'（任一满足）。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "and";
  value_list:         "and","or";

parameter
  Min:               input_control;
  description.english: 特征下限元组（与 Features 一一对应）。;
  default_type:       real;
  multivalue:         true;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      0.0;

parameter
  Max:               input_control;
  description.english: 特征上限元组（与 Features 一一对应）。;
  default_type:       real;
  multivalue:         true;
  sem_type:           number;
  type_list:          real,integer;
  default_value:      10000.0;

value_number:
  SelectedRegions <= Regions;


