parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  Region:            input_object;
  description.english: 输入 region。;
  sem_type:           region;
  multivalue:         optional;

parameter
  StructElement:     input_object;
