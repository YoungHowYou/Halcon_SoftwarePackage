parameter
  Type:              input_control;
  description.english: 类型（字符串或整数，见算子说明）。;
  default_type:       string;
  multivalue:         false;
  sem_type:           string;
  type_list:          string;
  default_value:      "convex";
  value_list:         rectangle1,rectangle2,ellipse,outer_circle,convex;

value_number:
  RegionTrans == Region;

cv_region_to_bin<- CHcv_region_to_bin[Region:BinImage:ForegroundGray,BackgroundGray,Width,Height:]
short.german
  Konvertiert eine Region in ein binaeres Bild (cv_region).;

