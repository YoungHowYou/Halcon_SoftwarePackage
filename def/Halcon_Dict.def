load_param<- CHload_param[::HParam,Level,DefaultValue,Competence,Type,Limit:Value]
short.english
  递归参数装载（hparams_core 的 LoadParam，1:1 对齐 hdev 过程 LoadParams）：按 Level 逐级下钻，节点不存在就写入 Competence/Type/Limit/Value 并返回默认值，已存在则直接返回其 Value（不覆盖）。Level 是路径，如 ['检测参数','背面','面积筛选']；Type 为 'int'/'float'/'bool'/'string'/'int[]'/'float[]'/'string[]' 等，'bool' 会把非法默认值纠成 'TRUE'，数组类型会把字符串按逗号切分、把子字典展平。;
short.german
  Rekursive Parameterladung (hparams_core LoadParam).;
module
  foundation;
chapter.english
  UserExtensions;
chapter.german
  BenutzerErweiterungen;
keywords.english
  param, load, json, dict, settings;

parallelization
  process_exclusively: false;
  process_locally:     false;
  process_mutual:      false;
  method:              none;

parameter
  HParam:             input_control;
  description.english: 参数树句柄（json），会被就地补全。;
  sem_type:           handle;
  type_list:          handle;
  default_type:       handle;
  multivalue:         false;

parameter
  Level:              input_control;
  description.english: 参数路径（一级目录、二级目录、标签……）。;
  sem_type:           string;
  type_list:          string;
  default_type:       string;
  multivalue:         true;

parameter
  DefaultValue:       input_control;
  description.english: 缺键时写入的默认值。;
  sem_type:           number;
  type_list:          real,integer,string;
  default_type:       real;
  multivalue:         true;

parameter
  Competence:         input_control;
  description.english: 权限等级（写进节点的 Competence）。;
  sem_type:           number;
  type_list:          integer;
  default_type:       integer;
  default_value:      1;
  multivalue:         false;

parameter
  Type:               input_control;
  description.english: 参数类型标识，如 int / float / bool / string / int[] / float[] / string[]。;
  sem_type:           string;
  type_list:          string;
  default_type:       string;
  multivalue:         false;

parameter
  Limit:              input_control;
  description.english: 取值限制（写进节点的 Limit，原样保存）。;
  sem_type:           number;
  type_list:          real,integer,string;
  default_type:       real;
  multivalue:         true;

parameter
  Value:              output_control;
  description.english: 取到的值（缺键时为写入的默认值）。;
  sem_type:           number;
  type_list:          real,integer,string;
  default_type:       real;
  multivalue:         true;


